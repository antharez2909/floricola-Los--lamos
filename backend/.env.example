# Copia este archivo como .env y completa los valores.
# El archivo .env NO debe subirse a GitHub (agrégalo a .gitignore).

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=pon_aqui_tu_clave_de_mysql
DB_NAME=floricola_db

# Cualquier texto largo y difícil de adivinar. Firma las sesiones y los tokens de la app.
SECRET_KEY=cambia-esto-por-un-texto-largo-y-aleatorio

# 1 = modo desarrollo (recarga automática). Déjalo vacío o en 0 fuera de tus pruebas.
FLASK_DEBUG=0

# Correo SMTP para verificación de cuentas y envío automático de comprobantes.
# Para Gmail usa una contraseña de aplicación, no tu contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
SMTP_STARTTLS=1

# Conexiones reutilizables de MySQL. 5 es suficiente para desarrollo/universidad.
DB_POOL_SIZE=5
